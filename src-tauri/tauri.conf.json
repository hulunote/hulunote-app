{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hulunote",
  "version": "0.1.0",
  "identifier": "top.hulunote.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8803/",
    "beforeDevCommand": "trunk serve ./index.html --address 127.0.0.1 --port 8803",
    "beforeBuildCommand": "trunk build --release --public-url ."
  },
  "app": {
    "windows": [
      {
        "title": "Hulunote",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
